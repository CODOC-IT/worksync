# ─── WorkSync Environment Configuration ───────────────────────

# JWT Authentication (REQUIRED)
JWT_SECRET="change_me_to_a_random_64_char_hex_string"
JWT_EXPIRES_IN="24h"

# ─── Supabase (integrated database, auth, realtime, storage) ───
# Create a project at https://supabase.com and get credentials from:
#   Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Required for server-side admin access (bypasses RLS)
# Get from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_INVITE_REDIRECT_URL=https://your-app.vercel.app
SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://your-app.vercel.app

# Database connection for backend (raw SQL via pg pool)
# Transaction pooler URL from Supabase Dashboard > Project Settings > Database > Connection Pooling > URI
# Use the session-mode (port 5432) or transaction-mode (port 6543) pooler URI
# Example with transaction pooler:
#   postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── AI Integrations (Groq) ──
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── Nodemailer Gmail SMTP (REQUIRED for OTP Email Delivery) ──
SMTP_USER="you@gmail.com"
SMTP_PASS="your_16_character_gmail_app_password"
ORGANIZATION_NAME="WorkSync"
APP_LOGIN_URL=https://your-app.vercel.app

# ─── Google OAuth Credentials (Optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
