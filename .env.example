# ─── WorkSync Environment Configuration ───────────────────────

# JWT Authentication (REQUIRED)
# Must be a secure random key of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_2026_production_grade_32chars"
JWT_EXPIRES_IN="24h"

# ─── Nodemailer Gmail SMTP (RECOMMENDED — No Domain Required, 500 emails/day) ───
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_USER="tahasohail85@gmail.com"
SMTP_PASS="your_gmail_app_password_here"

# ─── Brevo Email Service (Alternative) ────────────────────────
# Get your v3 API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-your_brevo_v3_api_key_here"
BREVO_SENDER_EMAIL="WorkSync <your_email@domain.com>"

# ─── Resend Email Service (Alternative) ────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="WorkSync <onboarding@resend.dev>"

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AI Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
