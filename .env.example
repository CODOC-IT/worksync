# ─── WorkSync Environment Configuration ───────────────────────

# JWT Authentication (REQUIRED)
# Must be a secure random key of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace with output of the generate command above
JWT_SECRET="change_me_to_a_random_64_char_hex_string"
JWT_EXPIRES_IN="24h"

# AI Integrations (Groq)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key"
# ─── Nodemailer Gmail SMTP (REQUIRED for OTP Email Delivery) ──
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_USER="tahasohail85@gmail.com"
SMTP_PASS="your_16_character_gmail_app_password"

# AI Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database & Supabase (Optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
