# ─── WorkSync Environment Configuration ───────────────────────

# JWT Authentication (REQUIRED)
# Must be a secure random key of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_2026_production_grade_32chars"
JWT_EXPIRES_IN="24h"

# ─── Resend Email Service (REQUIRED for OTP) ─────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
# Sender address — must be from a verified Resend domain.
# For testing, use: onboarding@resend.dev (sends to your own email only)
RESEND_FROM_EMAIL="WorkSync <onboarding@resend.dev>"

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AI Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=
